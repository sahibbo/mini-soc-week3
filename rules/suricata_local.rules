alert http any any -> $HOME_NET 80 (msg:"LABSHOP: HTTP Admin Path Access Detected"; flow:established,to_server; http.uri; content:"/admin"; startswith; sid:1000001; rev:1;)
alert tcp any any -> 10.10.10.30 any (msg:"LabShop SOC: repeated TCP connection attempts"; flags:S; threshold: type threshold, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1002101; rev:1;)
